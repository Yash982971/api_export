# ──────────────────────────────────────────────────────────────────────────────
# Google Sheets API - Automatic Outreach Tracking
# ──────────────────────────────────────────────────────────────────────────────
# Spreadsheet ID (from the Google Sheets URL)
GOOGLE_SHEETS_SPREADSHEET_ID=1TpqpbO9_cYFGDcFqIVidmvJR2lm5ply4ok-TFmP6H_I

# Tab name to use inside the spreadsheet (do not change unless the tab name changes)
GOOGLE_SHEETS_TAB_NAME=Yash Manglani

# Option A: Path to your downloaded Service Account JSON key file
# (Download from Google Cloud Console > IAM > Service Accounts > Keys)
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Option B: Raw JSON string from your service account key (alternative to file)
# Paste the entire JSON content of your service account key as a single line
GOOGLE_SERVICE_ACCOUNT_JSON=
